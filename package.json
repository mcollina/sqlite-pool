{
  "name": "@matteo.collina/sqlite-pool",
  "version": "0.8.0",
  "description": "A connection pool for better-sqlite3 compatible with atdatabases suite",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && node --test build/test/*test.js",
    "lint": "prettier --check src",
    "lint:fix": "prettier --write src"
  },
  "author": "Matteo Collina <hello@matteocollina.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/mcollina/sqlite-pool.git"
  },
  "dependencies": {
    "@databases/connection-pool": "^1.1.0",
    "@databases/escape-identifier": "^1.0.3",
    "@databases/split-sql-query": "^1.0.4",
    "@databases/sql": "^3.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.3"
  },
  "files": [
    "build/index.js",
    "build/index.d.ts",
    "build/index.js.map"
  ],
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
