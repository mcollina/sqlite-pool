{
  "name": "@matteo.collina/sqlite-pool",
  "version": "1.0.0",
  "description": "SQLite sync client and connection pool built on node:sqlite, compatible with the @databases suite",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && node --test build/test/*test.js",
    "lint": "prettier --check src",
    "lint:fix": "prettier --write src"
  },
  "author": "Matteo Collina <hello@matteocollina.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/mcollina/sqlite-pool.git"
  },
  "dependencies": {
    "@databases/connection-pool": "^1.1.0",
    "@databases/escape-identifier": "^1.0.3",
    "@databases/split-sql-query": "^1.0.4",
    "@databases/sql": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "prettier": "^3.9.10",
    "typescript": "^5.1.3"
  },
  "files": [
    "build/*.js",
    "build/*.d.ts",
    "build/*.js.map"
  ]
}
